<!DOCTYPE html>
<html>
<head><title>Edit Movie</title><link rel="stylesheet" href="/assets/style.css"></head>
<body>
<nav><a href="/">MovieHub</a><a href="/movies">Movies</a></nav>
<main><h1>Edit Movie</h1>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<form method="POST" action="/movies/<%= movie._id %>/edit" enctype="multipart/form-data">
<label>Title</label><input name="title" value="<%= movie.title %>" required>
<label>Description</label><textarea name="description" required><%= movie.description %></textarea>
<label>Genre</label><select name="genre" required><% genres.forEach(g => { %><option value="<%= g._id %>" <%= String(movie.genre) === String(g._id) ? 'selected' : '' %>><%= g.name %></option><% }) %></select>
<label>Release Year</label><input type="number" name="releaseYear" value="<%= movie.releaseYear %>" required>
<label>Rating</label><input type="number" name="rating" value="<%= movie.rating %>" min="0" max="10" step="0.1" required>
<label>Replace Image</label><input type="file" name="image" accept="image/*">
<button>Update Movie</button>
</form>
</main>
</body>
</html>
